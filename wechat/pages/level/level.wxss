/*
 * level.wxss
 *
 * Calm on purpose. The subject is a lawsuit that could reach the player's own
 * bank account, and a red-alarm interface on top of that reads as pressure
 * rather than teaching. Colour is reserved for the verdict and for the one
 * piece of evidence that works against them; everything else is paper and ink.
 *
 * rpx is WeChat's responsive unit: 750rpx = screen width.
 */

page {
  background: #F7F5F0;
  color: #1C1B20;
  font-size: 30rpx;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 32rpx 32rpx 96rpx;
  display: flex;
  flex-direction: column;
}

/* ── review gate ─────────────────────────────────────────────────────── */

.review {
  background: #FDF3E3;
  border: 2rpx solid #C88A22;
  border-left: 10rpx solid #C88A22;
  padding: 22rpx 24rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
}
.review-tag {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  color: #8A5D10;
  margin-bottom: 8rpx;
}
.review-body { font-size: 25rpx; color: #6B5326; line-height: 1.6; }

/* ── progress ────────────────────────────────────────────────────────── */

.progress { display: flex; align-items: center; margin-bottom: 36rpx; }
.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #E4DFD3;
  overflow: hidden;
}
.progress-fill { height: 100%; background: #2C6E63; transition: width .25s ease; }
.progress-text {
  margin-left: 18rpx;
  font-size: 22rpx;
  color: #8B8578;
  font-variant-numeric: tabular-nums;
}

/* ── type ────────────────────────────────────────────────────────────── */

.eyebrow {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #8B8578;
  margin: 8rpx 0 14rpx;
}
.h1 { display: block; font-size: 52rpx; line-height: 1.2; font-weight: 700; letter-spacing: -.5rpx; }
.h2 { display: block; font-size: 38rpx; line-height: 1.32; font-weight: 700; margin-bottom: 8rpx; }
.audience { display: block; font-size: 25rpx; color: #8B8578; margin: 10rpx 0 26rpx; }
.body { display: block; font-size: 30rpx; line-height: 1.75; }
.context { display: block; font-size: 26rpx; color: #6E6A61; margin-bottom: 24rpx; }

/* ── cards ───────────────────────────────────────────────────────────── */

.card {
  background: #FFFDF8;
  border: 2rpx solid #DCD6C8;
  padding: 26rpx;
  margin-bottom: 30rpx;
}
.card.insight { border-left: 10rpx solid #2C6E63; background: #F1F7F5; }
.card.hook { background: #F4F2EC; border-style: dashed; }

/* ── cast ────────────────────────────────────────────────────────────── */

.cast { padding-bottom: 10rpx; }
.person { margin-bottom: 26rpx; }
.person:last-child { margin-bottom: 16rpx; }
.person-head { display: flex; align-items: baseline; }
.person-name { font-weight: 600; font-size: 29rpx; }
.person-role { font-size: 23rpx; color: #8B8578; margin-left: 14rpx; }
.person-line {
  display: block;
  margin-top: 8rpx;
  font-size: 27rpx;
  color: #4A4740;
  line-height: 1.62;
}

/* ── evidence ────────────────────────────────────────────────────────── */

.ev { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 2rpx solid #EFEADC; }
.ev:last-child { border-bottom: 0; }
.ev-mark {
  flex: none;
  width: 40rpx; height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFDF8;
  background: #2C6E63;
  margin-right: 18rpx;
}
.ev-red .ev-mark { background: #B23A2E; }
.ev-text { flex: 1; }
.ev-label { display: block; font-size: 28rpx; line-height: 1.55; }
.ev-note { display: block; font-size: 24rpx; color: #B23A2E; margin-top: 4rpx; }

/* ── buttons ─────────────────────────────────────────────────────────── */

.btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 20rpx;
  padding: 26rpx 28rpx;
  font-size: 29rpx;
  line-height: 1.55;
  text-align: left;
  color: #1C1B20;
  background: #FFFDF8;
  border: 2rpx solid #1C1B20;
  border-radius: 0;
}
.btn::after { border: none; }
.btn.primary {
  background: #2C6E63;
  color: #FFFDF8;
  border-color: #2C6E63;
  text-align: center;
  font-weight: 600;
}
.btn.choice { display: flex; align-items: center; justify-content: space-between; }
.choice-label { flex: 1; }

/* A locked branch stays visible and tappable — tapping it is how the player
   is told why it is closed, which is the lesson. */
.btn.locked {
  color: #9A958A;
  background: #F0EDE4;
  border-color: #D3CDBF;
  border-style: dashed;
}
.choice-lock {
  flex: none;
  margin-left: 18rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #9A958A;
}

.locked-notice {
  background: #F4F2EC;
  border-left: 8rpx solid #9A958A;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
  color: #4A4740;
  line-height: 1.62;
  margin-top: 6rpx;
}

.nav { margin-top: 12rpx; }
.link { font-size: 26rpx; color: #2C6E63; text-decoration: underline; }

/* ── verdict ─────────────────────────────────────────────────────────── */

.verdict { padding: 30rpx 28rpx; margin-bottom: 32rpx; border: 2rpx solid; }
.verdict-tag {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.verdict-result { display: block; font-size: 33rpx; line-height: 1.5; font-weight: 600; }

.verdict-good  { background: #EEF6F3; border-color: #2C6E63; }
.verdict-good .verdict-tag { color: #22594F; }
.verdict-risky { background: #FDF3E3; border-color: #C88A22; }
.verdict-risky .verdict-tag { color: #8A5D10; }
.verdict-bad   { background: #FBEFEC; border-color: #B23A2E; }
.verdict-bad .verdict-tag { color: #8E2A21; }

/* ── legal basis ─────────────────────────────────────────────────────── */

.basis { background: #F4F2EC; }
.basis-row { display: flex; padding: 14rpx 0; border-bottom: 2rpx solid #E4DFD3; }
.basis-row:last-child { border-bottom: 0; }
.basis-key {
  flex: none;
  width: 190rpx;
  font-size: 23rpx;
  color: #8B8578;
  letter-spacing: 1rpx;
}
.basis-val { flex: 1; font-size: 25rpx; line-height: 1.6; color: #3A3730; }

/* ── skills ──────────────────────────────────────────────────────────── */

.skills { display: flex; flex-wrap: wrap; margin-bottom: 30rpx; }
.skill {
  font-size: 23rpx;
  letter-spacing: 1rpx;
  padding: 8rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
  color: #22594F;
  background: #EEF6F3;
  border: 2rpx solid #2C6E63;
}
